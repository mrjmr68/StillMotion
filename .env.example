# Supabase project settings > API (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Service role key — server-only, never expose to the client. Used for admin
# tasks (catalog import, RLS test setup). Not read by the app at runtime yet.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the magic-link redirect URL. Set to your deployed URL in
# Vercel; http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (server-side only — never exposed to the client)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5
